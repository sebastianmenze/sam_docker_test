# Copy this file to .env and fill in your values.
# docker-compose automatically reads .env from the same directory.

# Your Hugging Face token — needed to download gated SAM-Audio checkpoints.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# GitHub personal access token — needed to clone the private facebookresearch/perception repo.
# Generate one at https://github.com/settings/tokens (classic, read:packages scope is enough)
GITHUB_TOKEN=ghp_your_token_here

# Which GPU(s) to expose to the container.
# "all" = every GPU, "1" = only GPU index 1 (RTX A6000), "0,2" = two GPUs, etc.
NVIDIA_VISIBLE_DEVICES=all
